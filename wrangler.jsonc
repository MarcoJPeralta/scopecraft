{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Serve index.html for client-side routes (React Router BrowserRouter)
    "not_found_handling": "single-page-application"
  }
}
